{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "target": "ES2025",
    "lib": [
      "ES2025",
      "DOM"
    ],
    "types": [
      "vite/client"
    ],
    "rootDir": "./src",
    "allowJs": false,
    "isolatedModules": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ]
}
